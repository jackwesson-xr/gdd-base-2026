  friendlyName: Pip
  onActivated:
    m_PersistentCalls:
      m_Calls: []
  onActivatedBy:
    m_PersistentCalls:
      m_Calls: []
  activation: 1
  proximityRadius: 4
  order: 0
  style: 0
  lines:
  - text: Hi! I'm Pip. Press E to keep me talking.
    voice: {fileID: 0}
    advanced: 0
    onLine:
      m_PersistentCalls:
        m_Calls: []
    dropItem: {fileID: 0}
    dropOffset: {x: 0, y: 0.6, z: 1.6}
  - text: I can say my lines in order, pick one at random, or wait for an event to tell me what to say.
    voice: {fileID: 0}
    advanced: 0
    onLine:
      m_PersistentCalls:
        m_Calls: []
    dropItem: {fileID: 0}
    dropOffset: {x: 0, y: 0.6, z: 1.6}
  - text: Here, have a heart. And look at that box!
    voice: {fileID: 0}
    advanced: 1
    onLine:
      m_PersistentCalls:
        m_Calls:
        - m_Target: {fileID: 141572718}
          m_TargetAssemblyTypeName: GDD110.GddFocusMoment, Assembly-CSharp
          m_MethodName: Play
          m_Mode: 1
          m_Arguments:
            m_ObjectArgument: {fileID: 0}
            m_ObjectArgumentAssemblyTypeName: 
            m_IntArgument: 0
            m_FloatArgument: 0
            m_StringArgument: 
            m_BoolArgument: 0
          m_CallState: 2
    dropItem: {fileID: 3508827387215866169, guid: 95a7fad4e49db431e924b6138f98dbc3, type: 3}
    dropOffset: {x: 0.8, y: 0.6, z: 1.4}
  - text: 'That was a Focus Moment: the camera visits something, then comes back.'
    voice: {fileID: 0}
    advanced: 0
    onLine:
      m_PersistentCalls:
        m_Calls: []
    dropItem: {fileID: 0}
    dropOffset: {x: 0, y: 0.6, z: 1.6}
  mouth: {x: 0, y: -0.12, z: 0.46}
  bubbleOffset: {x: 0.8, y: 0.55}
