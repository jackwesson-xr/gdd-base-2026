        m_Calls: []
    dropItem: {fileID: 0}
    dropOffset: {x: 0, y: 0.6, z: 1.6}
  - text: ...thought bubbles trail little circles.
    voice: {fileID: 0}
    advanced: 0
    onLine:
      m_PersistentCalls:
        m_Calls: []
    dropItem: {fileID: 0}
    dropOffset: {x: 0, y: 0.6, z: 1.6}
