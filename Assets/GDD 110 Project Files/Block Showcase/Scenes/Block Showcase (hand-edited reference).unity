      m_Calls: []
  activation: 1
  proximityRadius: 4
  order: 0
  style: 0
  lines:
  - text: Hi! I'm Pip. Press E to keep me talking.
    voice: {fileID: 0}
    advanced: 0
    onLine:
      m_PersistentCalls:
        m_Calls: []
    dropItem: {fileID: 0}
    dropOffset: {x: 0, y: 0.6, z: 1.6}
  - text: I can say my lines in order, pick one at random, or wait for an event to tell me what to say.
    voice: {fileID: 0}
    advanced: 0
    onLine:
      m_PersistentCalls:
        m_Calls: []
    dropItem: {fileID: 0}
    dropOffset: {x: 0, y: 0.6, z: 1.6}
  - text: Here, have a heart. And look at that box!
    voice: {fileID: 0}
    advanced: 1
    onLine:
      m_PersistentCalls:
        m_Calls:
        - m_Target: {fileID: 14735897}
          m_TargetAssemblyTypeName: GDD110.GddFocusMoment, Assembly-CSharp
