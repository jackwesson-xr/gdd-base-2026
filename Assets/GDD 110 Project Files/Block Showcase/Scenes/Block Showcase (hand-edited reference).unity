            m_BoolArgument: 0
          m_CallState: 2
    dropItem: {fileID: 3508827387215866169, guid: 95a7fad4e49db431e924b6138f98dbc3, type: 3}
    dropOffset: {x: 0.8, y: 0.6, z: 1.4}
  - text: 'That was a Focus Moment: the camera visits something, then comes back.'
    voice: {fileID: 0}
    advanced: 0
    onLine:
      m_PersistentCalls:
        m_Calls: []
    dropItem: {fileID: 0}
    dropOffset: {x: 0, y: 0.6, z: 1.6}
